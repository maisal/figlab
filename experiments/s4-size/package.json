{
  "name": "figlab-experiment-s4-size",
  "version": "0.0.0",
  "private": true,
  "description": "S4: wasm module size, loading export later, and startup time (not part of figlab)",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "fonts": "node scripts/fetch-fonts.mjs",
    "sizes": "node scripts/build-wasm.mjs && node scripts/report.mjs",
    "build": "node scripts/build-wasm.mjs --app && vite build && node scripts/startup-bytes.mjs",
    "serve": "node scripts/serve.mjs",
    "measure": "node scripts/measure.mjs",
    "probe": "node scripts/probe.mjs",
    "typecheck": "tsc --noEmit -p .",
    "check-outputs": "node scripts/check-outputs.mjs",
    "build:wasm": "node scripts/build-wasm.mjs --app"
  },
  "dependencies": {
    "@preact/signals": "2.11.3",
    "codemirror": "6.0.2",
    "preact": "10.29.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.64.0",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  }
}
