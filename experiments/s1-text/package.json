{
  "name": "figlab-experiment-s1-text",
  "version": "0.0.0",
  "private": true,
  "description": "S1: text shaping in wasm, glyphs on Canvas, PDF library, fallback font",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "build:web": "esbuild web/main.ts --bundle --format=esm --target=es2022 --outfile=dist/web/main.js",
    "typecheck": "tsc -p web",
    "check:wasm": "node scripts/check-wasm-native.mjs",
    "measure": "pnpm run -s build:web && node scripts/measure.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.64.0",
    "typescript": "6.0.3"
  }
}
