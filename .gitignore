# Local, untracked files (e.g. personal notes and Japanese reference copies of the docs)
/local/

# Build output
/target/
/web/dist/

# Build output and downloads of the experiments (experiments/README.md)
/experiments/*/target/
/experiments/*/dist/
/experiments/*/pkg/
/experiments/*/downloads/

# npm packages (pnpm) and tool caches inside them, at any depth
node_modules/

# Personal mise settings
/mise.local.toml

# OS files
.DS_Store
